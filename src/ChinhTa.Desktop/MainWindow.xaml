<Window x:Class="ChinhTa.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Chính tả Việt — Bản thử nghiệm 0.1.16" Width="1250" Height="850" Closing="OnClosing">
<DockPanel Background="#F1F5F9">
<Menu DockPanel.Dock="Top"><MenuItem Header="Tệp"><MenuItem Header="Mở Word…" Click="OpenClick"/><MenuItem Header="Lưu bản sao…" Click="SaveClick"/></MenuItem><MenuItem Header="Kiểm tra"><MenuItem Header="Quét lại" Click="ScanClick"/><Separator/><MenuItem Header="Kiểm tra Word tự động…" Click="OfficeCheckClick"/><MenuItem Header="Mở thư mục chẩn đoán" Click="DiagnosticsFolderClick"/></MenuItem></Menu>
<StackPanel DockPanel.Dock="Top" Margin="12,8,12,0"><StackPanel Orientation="Horizontal"><TextBlock Text="Loại văn bản:" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="ProfilePicker" Width="230" SelectionChanged="ProfileChanged"><ComboBoxItem Content="Văn bản Nhà nước"/><ComboBoxItem Content="Văn bản Đảng"/><ComboBoxItem Content="Văn bản cá nhân"/></ComboBox></StackPanel><TextBlock x:Name="ProfileInfo" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#92400E"/></StackPanel>
<TextBlock DockPanel.Dock="Top" Margin="12,6,12,0" TextWrapping="Wrap" Text="Shape Line (Nhà nước): cơ quan/trích yếu dài 1/3–1/2 dòng chữ theo NĐ30; tiêu ngữ dài bằng dòng chữ. Khoảng cách và dung sai theo cấu hình kiểm tra."/>
<WrapPanel DockPanel.Dock="Top" Margin="12"><Button Content="Mở .docx" Click="OpenClick" Padding="16,8"/><Button Content="Sửa lỗi đang xem" Click="FixClick" Margin="8,0" Padding="16,8"/><Button Content="Sửa các lỗi đã tích" Click="FixCheckedClick" Padding="12,8" Margin="0,0,8,0"/><Button Content="Sửa tất cả lỗi" Click="FixAllClick" Padding="12,8" Margin="0,0,8,0"/><Button Content="Hoàn tác" Click="UndoClick" Padding="16,8"/><Button Content="Lưu bản sao" Click="SaveClick" Margin="8,0" Padding="16,8"/></WrapPanel>
<TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="12" TextWrapping="Wrap" Text="Mở file .docx để bắt đầu. Tài liệu gốc được giữ nguyên."/>
<Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="300"/></Grid.ColumnDefinitions>
<DocumentViewer x:Name="Preview"/>
<GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
<DockPanel Grid.Column="2" Margin="12,0,0,0"><TextBlock DockPanel.Dock="Top" Text="LỖI VÀ GỢI Ý" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/><TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,12" Text="Rê chuột hoặc chọn lỗi để đánh dấu riêng lỗi đó. Sửa tất cả chỉ áp dụng mục sửa được. Cảnh báo thủ công không bị sửa. Chưa kiểm tra đầy đủ mọi thành phần thể thức hoặc chính tả tiếng Việt."/>
<StackPanel DockPanel.Dock="Top" Margin="0,0,0,8"><StackPanel Orientation="Horizontal"><Button Content="Tích tất cả" Click="CheckAllClick" Padding="8,4"/><Button Content="Bỏ tích" Click="UncheckAllClick" Padding="8,4" Margin="8,0"/></StackPanel><TextBlock x:Name="CheckedCount" Text="Đã tích: 0 lỗi" Margin="0,6,0,0"/></StackPanel>
<ListBox x:Name="Issues" SelectionChanged="IssueSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Padding="10" Margin="0,4" Background="White" MouseEnter="IssueHover"><StackPanel><CheckBox Content="Chọn để sửa hàng loạt" IsEnabled="{Binding Issue.CanFix}" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Checked="CheckChanged" Unchecked="CheckChanged" Margin="0,0,0,6"/><TextBlock Text="{Binding Issue.DisplayText}" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Text="{Binding Issue.Citation}" Foreground="#475569" TextWrapping="Wrap" Margin="0,4"/><TextBlock Text="{Binding Issue.Message}" TextWrapping="Wrap" Margin="0,6"/><TextBlock Text="{Binding Issue.Suggestion, StringFormat=Gợi ý: {0}}" Foreground="#166534" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
</DockPanel></Grid></DockPanel>
</Window>
