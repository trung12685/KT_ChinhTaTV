<Window x:Class="ChinhTa.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Chính tả Việt — Bản thử nghiệm" Width="1250" Height="850" Closing="OnClosing">
<DockPanel Background="#F1F5F9">
<Menu DockPanel.Dock="Top"><MenuItem Header="Tệp"><MenuItem Header="Mở Word…" Click="OpenClick"/><MenuItem Header="Lưu bản sao…" Click="SaveClick"/></MenuItem><MenuItem Header="Kiểm tra"><MenuItem Header="Quét lại" Click="ScanClick"/></MenuItem></Menu>
<StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="12"><Button Content="Mở .docx" Click="OpenClick" Padding="16,8"/><Button Content="Sửa lỗi đã chọn" Click="FixClick" Margin="8,0" Padding="16,8"/><Button Content="Hoàn tác" Click="UndoClick" Padding="16,8"/><Button Content="Lưu bản sao" Click="SaveClick" Margin="8,0" Padding="16,8"/></StackPanel>
<TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="12" TextWrapping="Wrap" Text="Mở file .docx để bắt đầu. Tài liệu gốc được giữ nguyên."/>
<Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="300"/></Grid.ColumnDefinitions>
<DocumentViewer x:Name="Preview"/>
<GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
<DockPanel Grid.Column="2" Margin="12,0,0,0"><TextBlock DockPanel.Dock="Top" Text="LỖI VÀ GỢI Ý" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/><TextBlock DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,12" Text="Rê chuột hoặc chọn lỗi để xem vị trí. Bản thử chỉ kiểm tra nội dung chính và bảng, chưa kiểm tra đầu/chân trang, hộp văn bản hoặc toàn bộ chính tả tiếng Việt."/>
<ListBox x:Name="Issues" SelectionChanged="IssueSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><Border Padding="10" Margin="0,4" Background="White" MouseEnter="IssueHover"><StackPanel><TextBlock Text="{Binding Original}" FontWeight="Bold" TextWrapping="Wrap"/><TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,6"/><TextBlock Text="{Binding Replacement, StringFormat=Gợi ý: {0}}" Foreground="#166534" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox>
</DockPanel></Grid></DockPanel>
</Window>
