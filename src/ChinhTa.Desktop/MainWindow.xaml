<Window x:Class="ChinhTa.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:ChinhTa.Desktop" Title="Chính tả Việt — Bản thử nghiệm 0.1.59" Width="1250" Height="850" Closing="OnClosing">
<DockPanel Background="#F1F5F9">
<Menu DockPanel.Dock="Top"><MenuItem Header="Tệp"><MenuItem Header="Mở Word…" Click="OpenClick"/><MenuItem Header="Lưu bản sao…" Click="SaveClick"/></MenuItem><MenuItem Header="Kiểm tra"><MenuItem Header="Quét lại" Click="ScanClick"/><MenuItem Header="Thử nghiệm đọc dữ liệu nhanh" IsCheckable="True" IsChecked="True" Click="ReadingModeClick"/><Separator/><MenuItem Header="Kiểm tra Word tự động…" Click="OfficeCheckClick"/><MenuItem Header="Mở thư mục chẩn đoán" Click="DiagnosticsFolderClick"/></MenuItem><MenuItem Header="Trợ giúp"><MenuItem Header="Tiến độ và chức năng…" Click="ProgressReportClick"/><MenuItem Header="Danh mục tên loại văn bản…" Click="DocumentTypesClick"/></MenuItem></Menu>
<StackPanel DockPanel.Dock="Top" Margin="12,8,12,0"><StackPanel Orientation="Horizontal"><TextBlock x:Name="BuildVersion" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,16,0"/><TextBlock Text="Loại văn bản:" VerticalAlignment="Center" Margin="0,0,8,0"/><ComboBox x:Name="ProfilePicker" Width="230" SelectionChanged="ProfileChanged"><ComboBoxItem Content="Văn bản Nhà nước"/><ComboBoxItem Content="Văn bản Đảng"/><ComboBoxItem Content="Văn bản cá nhân"/></ComboBox></StackPanel><TextBlock x:Name="ProfileInfo" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="#92400E"/></StackPanel>
<TextBlock DockPanel.Dock="Top" Margin="12,6,12,0" TextWrapping="Wrap" Text="Shape Line (Nhà nước): cơ quan/trích yếu dài 1/3–1/2 dòng chữ theo NĐ30, tự tạo theo mức 3/7 đã chọn; tiêu ngữ dài bằng dòng chữ. Khoảng cách và dung sai theo cấu hình kiểm tra."/>
<TextBlock x:Name="CoverageInfo" DockPanel.Dock="Top" Visibility="Collapsed" Margin="12,6,12,0" TextWrapping="Wrap" Foreground="#475569"/>
<WrapPanel DockPanel.Dock="Top" Margin="12"><Button Content="Mở .docx" Click="OpenClick" Padding="16,8"/><Button Content="Sửa lỗi đang xem" Click="FixClick" Margin="8,0" Padding="16,8"/><Button Content="Sửa các lỗi đã tích" Click="FixCheckedClick" Padding="12,8" Margin="0,0,8,0"/><Button Content="Sửa tất cả lỗi" Click="FixAllClick" Padding="12,8" Margin="0,0,8,0"/><Button Content="Hoàn tác" Click="UndoClick" Padding="16,8"/><Button Content="Lưu bản sao" Click="SaveClick" Margin="8,0" Padding="16,8"/></WrapPanel>
<TextBlock x:Name="Status" DockPanel.Dock="Bottom" Margin="12" TextWrapping="Wrap" Text="Mở file .docx để bắt đầu. Tài liệu gốc được giữ nguyên."/>
<Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*" MinWidth="300"/></Grid.ColumnDefinitions>
<DocumentViewer x:Name="Preview"/>
<GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch"/>
<local:IssueReviewPanel x:Name="Review" Grid.Column="2" Margin="12,0,0,0"/>
</Grid></DockPanel>
</Window>

