<UserControl x:Class="ChinhTa.Desktop.IssueReviewPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" MinWidth="300">
<UserControl.Resources>
 <DataTemplate x:Key="SectionHeader"><Grid Margin="0,4,0,3" ToolTip="{Binding Name.Detail}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding Name.IsChecked, Mode=TwoWay}" IsEnabled="{Binding Name.CanSelect}" VerticalAlignment="Center" Margin="0,0,5,0" AutomationProperties.Name="{Binding Name.Title}"/><TextBlock Grid.Column="1" Text="{Binding Name.Title}" FontSize="12" FontWeight="Bold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Name.CountText}" FontSize="11" Foreground="#475569" Margin="6,0,3,0" VerticalAlignment="Center"/></Grid></DataTemplate>
 <DataTemplate x:Key="FamilyHeader"><Grid Margin="0,2,0,2" ToolTip="{Binding Name.Detail}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding Name.IsChecked, Mode=TwoWay}" IsEnabled="{Binding Name.CanSelect}" VerticalAlignment="Center" Margin="0,0,5,0" AutomationProperties.Name="{Binding Name.Title}"/><TextBlock Grid.Column="1" Text="{Binding Name.Title}" FontSize="12" Foreground="#334155" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Name.CountText}" Foreground="#64748B" FontSize="11" Margin="6,0,3,0" VerticalAlignment="Center"/></Grid></DataTemplate>
 <Style x:Key="GroupContainer" TargetType="GroupItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="GroupItem"><Expander IsExpanded="{Binding Name.IsExpanded, Mode=TwoWay}" HorizontalContentAlignment="Stretch" Header="{TemplateBinding Content}" HeaderTemplate="{TemplateBinding ContentTemplate}"><ItemsPresenter Margin="8,0,0,2"/></Expander></ControlTemplate></Setter.Value></Setter></Style>
</UserControl.Resources>
<DockPanel>
 <TextBlock DockPanel.Dock="Top" Text="LỖI VÀ GỢI Ý" FontSize="18" FontWeight="Bold" Margin="0,0,0,6"/>
 <Grid DockPanel.Dock="Top" Margin="0,0,0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><CheckBox x:Name="AllCheck" Content="Tất cả" IsChecked="{Binding All.IsChecked, Mode=TwoWay}" IsEnabled="{Binding All.CanSelect}" ToolTip="{Binding All.Detail}" VerticalAlignment="Center"/><TextBlock x:Name="Summary" Grid.Column="1" HorizontalAlignment="Right" FontSize="12" Foreground="#475569" VerticalAlignment="Center"/></Grid>
 <Expander x:Name="Details" DockPanel.Dock="Bottom" Header="Chi tiết lỗi" Margin="0,6,0,0" IsExpanded="False"><ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="DetailText" Text="Chọn lỗi để xem mô tả, gợi ý và căn cứ." TextWrapping="Wrap" Margin="4,6" FontSize="12"/></ScrollViewer></Expander>
 <Grid>
  <TextBlock x:Name="Empty" Text="Chưa có mục để hiển thị." Foreground="#64748B" Margin="6,12"/>
  <ListBox x:Name="IssueList" SelectionChanged="IssueSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" Background="White" BorderBrush="#CBD5E1" ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="30000">
   <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Height" Value="28"/><Setter Property="Padding" Value="2,0"/><Setter Property="Margin" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListBox.ItemContainerStyle>
   <ListBox.GroupStyle><GroupStyle HeaderTemplate="{StaticResource SectionHeader}" ContainerStyle="{StaticResource GroupContainer}"/><GroupStyle HeaderTemplate="{StaticResource FamilyHeader}" ContainerStyle="{StaticResource GroupContainer}"/></ListBox.GroupStyle>
   <ListBox.ItemTemplate><DataTemplate><Grid Height="26" MouseEnter="IssueHover" ToolTipService.InitialShowDelay="350" ToolTipService.ShowDuration="30000"><Grid.ToolTip><ToolTip MaxWidth="460"><TextBlock Text="{Binding Detail}" TextWrapping="Wrap"/></ToolTip></Grid.ToolTip><Grid.ColumnDefinitions><ColumnDefinition Width="22"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsEnabled="{Binding Issue.CanFix}" IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{Binding SelectionLabel}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="13" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding Location}" Foreground="#64748B" FontSize="11" Margin="6,0,3,0" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
 </Grid>
</DockPanel>
</UserControl>
